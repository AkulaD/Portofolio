
@media (max-width: 460px) {
    .container {
        min-height: 50%;
    }
    
    .right-nav ul {
        display: none;
    }

    .contact-body ul {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
    }

    .contact-body ul li img{
        width: 50px;
        gap: 10px;
    }

    #about-header{
        min-height: 70vh;
    }

    .left-nav{
        width: 40%;
    }

    .left-nav p{
        font-size: 0.7rem;
        margin-right: 0;
    }

    .right-about-body p{
        font-size: 0.9rem
    }

    .left-about-body h1{
        font-size: 1.4rem;
    }

    .left-about-body p{
        font-size: 0.9rem;
    }


    .left-about-body h2{
        font-size: 1.4rem;
    }

    .right-nav{
        padding: 0px;
        width: auto;
    }

    .right-about-body{
        overflow: hidden;
        padding: 0px;
    }

    #about h2{
        font-size: 1.5rem;
        margin: 1rem 3rem;
    }

    #about p{
        font-size: 0.9rem;
        padding: 0px 20px;
        padding: 0 3rem;
        margin-bottom: 1rem;
    }

    .skills {
        padding: 0px;
        margin: 0 30px;
    }

    .skills h2{
        font-size: 1.5rem;
        margin-bottom: 5px;
    }

    .skills ul li{
        font-size: 1rem;
    }

    .program-language ul{
        gap: 15px;
    }

    .experience h1{
        font-size: 1.8rem;
    }

    .timeline-body img{
        width: 200px;
    }

    .timeline-body h2{
        font-size: 1.3rem;
    }

    .timeline-body time{
        font-size: 1rem;
    }

    .timeline-body p{
        font-size: 1rem;
    }

    .timeline-body ul li{
        font-size: 1rem;
    }

    #projects .body-project h1{
        font-size: 1.8rem;
    }

    #projects .body-project h2{
        font-size: 1.5rem;
        padding: 300px 0px;
    }

    #education h1{
        font-size: 1.8rem;
    }

    .timeline-edu h1{
        font-size: 1.8rem;
    }

    .timeline-edu-item{
        margin-bottom: 40px;
    }

    .timeline-edu-content img{
        width: 150px;
    }

    .timeline-edu-content h2{
        font-size: 1.3rem;
    }

    .timeline-edu-content time{
        font-size: 1rem;
    }

    .timeline-edu-content p{
        font-size: 1rem;
    }

    #unpam img{
        width: 100px;
    }

    #unpam h2{
        font-size: 1.3rem;
    }

    #unpam time{
        font-size: 1rem;
    }

    #unpam p{
        font-size: 1.1rem;
        margin: 5px 0px;
    }

    #smkn6 img{
        width: 60px;
    }

    #smkn6 h2{
        font-size: 1.3rem;
    }

    #smkn6 time{
        font-size: 1rem;
    }

    #smkn6 p{
        font-size: 1.1rem;
        margin: 5px 0px;
    }

    .extracirricular h3{
        font-size: 1.2rem;
    }

    #smkn6 ul li{
        font-size: 1rem;
        margin: 0 10px;
    }

    #smpn15 img{
        width: 60px;
    }

    #smpn15 h2{
        font-size: 1.3rem;
    }

    #smpn15 time{
        font-size: 1rem;
    }

    #smpn15 p{
        font-size: 1.1rem;
        margin: 5px 0px;
    }

    #sd img{
        width: 100px;
    }

    #sd h2{
        font-size: 1.3rem;
    }

    #sd time{
        font-size: 1rem;
    }

    #sd p{
        font-size: 1.1rem;
        margin: 5px 0px;
    }

    #contact-container h1{
        font-size: 1.8rem;
    }

    #contact-container p{
        font-size: 1rem;
        margin: 0px 10px;
    }

    .footer-container p{
        font-size: 1rem;
    }
}

