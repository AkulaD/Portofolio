@media (min-width: 690px) and (max-width: 1024px) {
    .right-nav{
        width: 60%;
        padding: 0;
        margin: 0 1rem;
    }

    .right-nav ul{
        gap: 15px;
    }
}

@media (max-width: 769px) {
    .responsive-menu-nav{
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 1rem 2rem;
    }

    .responsive-menu-nav img{
        width: 3rem;
        z-index: 10000;
    }

    .responsive-menu-nav button{
        border: none;
        background-color: transparent;
    }

    .responsive-nav{
        position: fixed;
        top: 0;
        right: 0;
        width: 50%;
        height: 100vh;
        background-color: rgb(203, 203, 203);
        display: none;
        flex-direction: column;
        align-items: center;
        padding: 20px;
        justify-content: flex-start;
        z-index: 900;
    }

    .responsive-nav ul{
        list-style: none;
        padding: 0;
        margin: 0;
        display: flex;
        flex-direction: column;
        gap: 40px;
    }

    .responsive-nav ul li a{
        font-size: 1.5rem;
        color: var(--color-black);
        font-family:'Gill Sans', 'Gill Sans MT', Calibri, 'Trebuchet MS', sans-serif;
        text-decoration: none;
        transition: color 0.3s ease;
    }

    .responsive-nav ul li a:hover{
        color: var(--hover-color);
        text-decoration: underline;
        font-size: 1.8rem;
        transition: color 0.3s ease, font-size 0.3s ease, font-weight 0.3s ease;
    }

    .responsive-nav button{
        border: none;
        background-color: transparent;
    }

    .responsive-nav img{
        width: 3rem;
        position: fixed;
        top: 0;
        right: 0;
        margin: 1rem 3rem;
    }
}

@media (min-width:769px){
    .responsive-menu-nav{
        display: none;
    }

    .responsive-nav{
        display: none;
    }

    .hidenav{
        display: none;
    }
}

@media (max-width:395px){
    .left-nav p{
        display: none;
    }
}

@media (min-width:768px) and (max-width:836px){
    .contact-body img{
        width: 50px;
    }
}